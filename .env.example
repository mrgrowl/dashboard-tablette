# Copier en .env.local pour le dev (npm run dev les lit automatiquement).
# En production (Coolify), ce sont des variables de build Docker — voir
# docker-compose.yml (elles sont passées en "args" au service web) et le
# README pour la marche à suivre.

# Identifiants du compte "plateforme Data" Grand Lyon (PAS FranceConnect) —
# https://data.grandlyon.com/portail/fr/mot-de-passe-oublie
VITE_TCL_LOGIN=
VITE_TCL_PASSWORD=

# Adresse secrète au format iCal du calendrier Google à afficher
# (Google Calendar → Paramètres → [ton agenda] → Intégrer l'agenda →
# Adresse secrète au format iCal).
VITE_CALENDAR_ICS_URL=

# Optionnel : URL absolue du relais calendrier si hébergé séparément du
# front. Laisser vide en usage normal (chemin relatif "/api/...", proxifié
# par Vite en dev et par nginx en prod).
VITE_CALENDAR_RELAY_URL=
